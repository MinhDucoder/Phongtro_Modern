import mongoose from 'mongoose';
import dotenv from 'dotenv';

dotenv.config();

// URI từ MongoDB Atlas
const atlasUri = "mongodb+srv://ducyberxdev:ducyberxdev@phongtrovn.tqxpcgt.mongodb.net/PhongTroVN?retryWrites=true&w=majority&appName=PhongTroVN";

// URI từ biến môi trường (nếu có)
const envUri = process.env.MONGODB_URI || process.env.DB_URI;

// URI được sử dụng
const uri = envUri || atlasUri;

const clientOptions = {
  serverApi: { version: '1', strict: true, deprecationErrors: true },
  ssl: true,
  tls: true,
  connectTimeoutMS: 30000, // Tăng timeout lên 30 giây
  socketTimeoutMS: 45000,   // Tăng socket timeout
  maxPoolSize: 50,          // Tăng kích thước pool
  retryWrites: true,
  useNewUrlParser: true,
  useUnifiedTopology: true
};

export const connectDB = async () => {
  try {
    console.log('Connecting to MongoDB...');
    // Xóa tất cả các kết nối hiện có
    if (mongoose.connection.readyState !== 0) {
      await mongoose.connection.close();
    }

    // Kết nối mới
    await mongoose.connect(uri, clientOptions);
    
    console.log('MongoDB connection state:', mongoose.connection.readyState);
    console.log('Connected to MongoDB successfully!');
    
    // Kiểm tra kết nối bằng cách ping database
    const adminDb = mongoose.connection.db.admin();
    const result = await adminDb.ping();
    console.log('MongoDB ping result:', result);
    
    return true;
  } catch (error) {
    console.error('MongoDB connection error:', error);
    
    // Thử kết nối lại với localhost nếu kết nối đến Atlas thất bại
    if (uri.includes('mongodb+srv')) {
      try {
        console.log('Trying to connect to local MongoDB...');
        const localUri = 'mongodb://localhost:27017/phongtro';
        await mongoose.connect(localUri, {
          useNewUrlParser: true,
          useUnifiedTopology: true
        });
        console.log('Connected to local MongoDB successfully!');
        return true;
      } catch (localError) {
        console.error('Local MongoDB connection failed:', localError);
      }
    }
    
    return false;
  }
};