# Copy this file to .env and fill values

# MongoDB Atlas connection string (or local Mongo)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/phongtro?retryWrites=true&w=majority

# Session secret for express-session
SESSION_SECRET=your_session_secret_here

# Frontend url used for CORS and links
FRONTEND_URL=http://localhost:3000

# MeiliSearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey
MEILISEARCH_INDEX=posts

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Email (Gmail app password) - optional for dev features
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Cloudinary - optional if you use remote storage for images
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
